			"name": "按住跳跃键跳起来",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "every_frame"},
			"conditions": [
				{"type": "key_held", "key": "ui_accept"},
				{"type": "grounded", "target": "tag:player"}
			],
			"actions": [
				{"type": "jump", "target": "tag:player", "height": 190}
			]
		},
		{
			"id": "rule_move_left",
			"name": "按住左方向键向左移动",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "every_frame"},
			"conditions": [
				{"type": "key_held", "key": "ui_left"}
			],
			"actions": [
				{"type": "set_velocity", "target": "tag:player", "vx": -320}
			]
		},
		{
			"id": "rule_move_right",
			"name": "按住右方向键向右移动",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "every_frame"},
			"conditions": [
				{"type": "key_held", "key": "ui_right"}
			],
			"actions": [
				{"type": "set_velocity", "target": "tag:player", "vx": 320}
			]
		},
		{
			"id": "rule_move_stop",
			"name": "松开方向键就停下",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "every_frame"},
			"conditions": [
				{"type": "key_held", "key": "ui_left", "negate": true},
				{"type": "key_held", "key": "ui_right", "negate": true}
			],
			"actions": [
				{"type": "set_velocity", "target": "tag:player", "vx": 0}
			]
		},
		{
			"id": "rule_coin",
			"name": "吃到金币加分",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "collision", "a": "tag:player", "b": "tag:coin"},
			"conditions": [],
			"actions": [
				{"type": "change_property", "target": "tag:player", "property": "score", "delta": 1},
				{"type": "destroy", "target": "other"}
			]
		},
		{
			"id": "rule_hurt",
			"name": "碰到尖刺扣血",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "collision", "a": "tag:player", "b": "tag:hazard"},
			"conditions": [],
			"actions": [
				{"type": "change_property", "target": "tag:player", "property": "hp", "delta": -1},
				{"type": "apply_impulse", "target": "tag:player", "vx": 0, "vy": -450}
			]
		},
		{
			"id": "rule_win",
			"name": "集齐金币获胜",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "property_change", "target": "tag:player", "property": "score"},
			"conditions": [
				{"type": "compare", "target": "tag:player", "property": "score", "op": ">=", "value": 5}
			],
			"actions": [
				{"type": "end_game", "result": "win", "message": "金币全部收集完成！"}
			]
		},
		{
			"id": "rule_lose",
			"name": "血量归零失败",
			"enabled": true,
			"scene_id": "",
			"trigger": {"type": "property_change", "target": "tag:player", "property": "hp"},
			"conditions": [
				{"type": "compare", "target": "tag:player", "property": "hp", "op": "<=", "value": 0}
			],
			"actions": [
				{"type": "end_game", "result": "lose", "message": "小恐龙倒下了"}
			]
		}
